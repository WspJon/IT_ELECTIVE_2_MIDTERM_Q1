@model List<MagicCardApp.Models.MagicCard>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Magic Card Search</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background: linear-gradient(180deg, #1b1625 0%, #3a223f 100%);
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        .top-nav {
            display: flex;
            justify-content: flex-end;
            padding: 20px 40px;
        }

            .top-nav a {
                color: #a08ba8;
                text-decoration: none;
                margin-left: 20px;
                font-weight: 500;
                font-size: 14px;
            }

                .top-nav a:hover {
                    color: #ffffff;
                }

        .search-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            z-index: 10;
        }

        .headline {
            font-size: 26px;
            font-weight: 400;
            margin-bottom: 24px;
            text-align: center;
        }

        .search-form {
            width: 100%;
            max-width: 600px;
        }

        .input-wrapper {
            position: relative;
            width: 100%;
        }

        .search-input {
            width: 100%;
            height: 48px;
            background-color: #17111c;
            border: 1px solid #4a3455;
            border-radius: 4px;
            color: #ffffff;
            font-size: 16px;
            padding: 10px 15px 10px 45px;
            outline: none;
        }

            .search-input:focus {
                border-color: #8c6a9c;
            }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 22px;
            height: 22px;
            background-color: #e4e4e4;
            border-radius: 50%;
        }

        /* Results Section (Lilitaw kapag may nasearch) */
        .results-section {
            width: 90%;
            max-width: 1100px;
            margin: 20px auto 50px auto;
            background: #ffffff;
            color: #000000;
            border-radius: 8px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            z-index: 20;
        }

        /* Live Cards Fan Design sa Ibaba */
        .cards-fan {
            position: fixed;
            bottom: -30px;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: flex-end;
            pointer-events: none;
            z-index: 1;
        }

            .cards-fan img {
                width: 190px;
                border-radius: 9px;
                box-shadow: 0 5px 25px rgba(0,0,0,0.6);
                margin: 0 -25px;
                transition: transform 0.3s;
            }

                .cards-fan img:nth-child(1) {
                    transform: translateY(20px) rotate(-4deg);
                }

                .cards-fan img:nth-child(2) {
                    transform: translateY(5px) rotate(-2deg);
                }

                .cards-fan img:nth-child(3) {
                    transform: translateY(-5px) rotate(0deg);
                }

                .cards-fan img:nth-child(4) {
                    transform: translateY(5px) rotate(2deg);
                }

                .cards-fan img:nth-child(5) {
                    transform: translateY(20px) rotate(4deg);
                }

        @@media (max-width: 768px) {
            .cards-fan {
                display: none;
            }
            /* Itatago sa maliit na screen para hindi sumikip */
        }
    </style>
</head>
<body>

    <div class="top-nav">
        <a asp-controller="Account" asp-action="Login">Log In</a>
        <a asp-controller="Account" asp-action="Register">Register</a>
    </div>

    <!-- Search Box Section -->
    <div class="search-container">
        <h1 class="headline">Scryfall is a powerful <strong>Magic: The Gathering</strong> card search</h1>

        <form asp-controller="Card" asp-action="Index" method="post" class="search-form">
            <div class="input-wrapper">
                <div class="search-icon"></div>
                <input type="text" name="searchQuery" class="search-input" autofocus autocomplete="off" placeholder="Search for cards..." required />
            </div>
        </form>
    </div>

    <!-- Results Display Section (Kung may nasearch na) -->
    @if (Model != null && Model.Any())
    {
        <div class="results-section">
            <h4 class="mb-3">Found @Model.Count cards:</h4>
            <div class="row">
                <div class="col-md-4">
                    <div class="list-group shadow-sm" style="max-height: 500px; overflow-y: auto;">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <button type="button" class="list-group-item list-group-item-action @(i == 0 ? "active" : "")"
                                    onclick="showCardDetails(@i)">
                                @Model[i].Name
                            </button>
                        }
                    </div>
                </div>

                <div class="col-md-8">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var card = Model[i];
                        <div id="details-@i" class="card-details-pane" style="display: @(i == 0 ? "block" : "none");">
                            <h2 class="fw-bold">@card.Name</h2>
                            <p class="text-muted">@card.TypeLine</p>

                            <div class="row mt-3">
                                <div class="col-md-5">
                                    @if (!string.IsNullOrEmpty(card.ImageUrl))
                                    {
                                        <img src="@card.ImageUrl" class="img-fluid rounded shadow" alt="@card.Name" />
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                                            <span class="text-muted">No Image Available</span>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-7">
                                    <h6 class="fw-bold text-muted">Rules text</h6>
                                    <p style="white-space: pre-wrap;">@card.OracleText</p>

                                    @if (!string.IsNullOrEmpty(card.FlavorText))
                                    {
                                        <p class="text-muted fst-italic">"@card.FlavorText"</p>
                                    }

                                    <div class="mt-4 pt-3 border-top text-muted">
                                        @if (!string.IsNullOrEmpty(card.PowerToughness))
                                        {
                                            <span class="me-3 fw-bold text-dark">@card.PowerToughness</span>
                                        }
                                        <span class="me-3 text-uppercase">@card.Set</span>
                                        <span class="text-capitalize">@card.Rarity</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Live Cards Design sa Ibaba -->
    <div class="cards-fan">
        <img src="https://cards.scryfall.io/normal/front/2/2/227cea1b-ce67-4fd8-9815-92571bface42.jpg" alt="Shivan Dragon" />
        <img src="https://cards.scryfall.io/normal/front/a/4/a457f404-ddf1-40fa-b0f0-23c8598533f4.jpg" alt="Counterspell" />
        <img src="https://cards.scryfall.io/normal/front/b/d/bd8fa327-dd41-4737-8f19-2cf5eb1f7cdd.jpg" alt="Black Lotus" />
        <img src="https://cards.scryfall.io/normal/front/0/6/06ec9e8b-4bd8-46b5-9661-2c2e8717df39.jpg" alt="Giant Growth" />
        <img src="https://cards.scryfall.io/normal/front/c/e/ce711943-c1a1-43a0-8b89-8d169cfb8e06.jpg" alt="Lightning Bolt" />
    </div>

    <script>
        function showCardDetails(index) {
            document.querySelectorAll('.card-details-pane').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.list-group-item').forEach(el => el.classList.remove('active'));

            document.getElementById('details-' + index).style.display = 'block';
            event.currentTarget.classList.add('active');
        }
    </script>
</body>
</html>