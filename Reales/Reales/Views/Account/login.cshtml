@{
    // Tinanggal ang layout para makuha ang full-screen split design
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In</title>
    <style>
        /* CSS Reset */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #ffffff;
            color: #000000;
        }

        /* 100% Accurate Full Screen Split Layout */
        .split-layout {
            display: flex;
            height: 100vh;
        }

        /* Left Side (TCGplayer Purple) */
        .left-panel {
            flex: 0 0 33%;
            background-color: #390bd8;
            position: relative;
            background-image: url('image_00ef7b.png'); /* Palitan ito ng URL ng iyong background image */
            background-size: cover;
            background-position: center;
        }

        /* Right Side (Form Area) */
        .right-panel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        h1 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 28px;
            color: #000000;
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #000000;
        }

        input.form-control {
            width: 100%;
            height: 42px;
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }

            input.form-control:focus {
                border-color: #390bd8;
            }

        .forgot-link {
            display: block;
            text-align: right;
            font-size: 12px;
            color: #390bd8;
            text-decoration: underline;
            margin-top: 8px;
        }

        .btn-signin {
            width: 100%;
            height: 44px;
            background-color: #390bd8;
            color: #ffffff;
            border: none;
            border-radius: 4px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 20px;
            margin-bottom: 16px;
            transition: opacity 0.2s;
        }

            .btn-signin:hover {
                opacity: 0.9;
            }

        .stay-signed-in {
            display: flex;
            align-items: center;
            margin-bottom: 28px;
        }

            .stay-signed-in input[type="checkbox"] {
                margin-right: 8px;
                accent-color: #390bd8;
                width: 15px;
                height: 15px;
                cursor: pointer;
            }

            .stay-signed-in label {
                margin: 0;
                font-size: 13px;
                font-weight: 400;
                cursor: pointer;
            }

        .captcha-text {
            font-size: 12px;
            color: #6b7280;
            margin-bottom: 30px;
            line-height: 1.5;
        }

            .captcha-text a {
                color: #4b5563;
                text-decoration: underline;
            }

        .register-text {
            text-align: center;
            font-size: 12px;
            font-weight: 600;
            color: #000000;
        }

            .register-text a {
                color: #390bd8;
                text-decoration: none;
                display: block;
                margin-top: 4px;
                font-weight: 400;
            }

                .register-text a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 768px) {
            .split-layout {
                flex-direction: column;
            }

            .left-panel {
                height: 150px;
                flex: none;
            }

            .right-panel {
                padding: 40px 20px;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>

    <div class="split-layout">

        <div class="left-panel">
        </div>

        <div class="right-panel">
            <div class="form-container">

                <h1>Sign in</h1>

                <form asp-action="Login" method="post">

                    <div class="form-group">
                        <!-- Pinalitan na ito sa Username -->
                        <label>Username</label>
                        <input type="text" name="username" class="form-control" placeholder="Enter your username" required />
                    </div>

                    <div class="form-group">
    <label>Password</label>
    <!-- Idinagdag natin ang placeholder dito -->
    <input type="password" name="password" class="form-control" placeholder="Enter your password" required />
    <a asp-controller="Account" asp-action="ForgotPassword" class="forgot-link">Forgot Password?</a>
</div>
                    <button type="submit" class="btn-signin">Sign In</button>

                    <div class="stay-signed-in">
                        <input type="checkbox" id="staySignedIn" checked />
                        <label for="staySignedIn">Stay signed in</label>
                    </div>

                    <div class="captcha-text">
                        This site is protected by hCaptcha and its <a href="#">Privacy Policy</a> and <a href="#">Terms of Service</a> apply.
                    </div>

                    <div class="register-text">
                        Don't have an account yet?
                        <a asp-controller="Account" asp-action="Register">Make one here</a>
                    </div>

                </form>
            </div>
        </div>
    </div>

</body>
</html>