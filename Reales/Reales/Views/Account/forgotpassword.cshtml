@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-5">
                <h2 class="text-center fw-bold mb-4">Reset Password</h2>
                <p class="text-muted text-center mb-4">Enter your username and we will help you reset your password.</p>

                <!-- Kapag success, ipapakita ang green alert -->
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success text-center" role="alert">
                        @ViewBag.Message
                    </div>
                }

                <form asp-action="ForgotPassword" method="post">
                    <div class="mb-4">
                        <label class="form-label fw-bold">Username</label>
                        <input type="text" name="username" class="form-control" placeholder="Enter your username" required>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2 fw-bold text-dark">Send Reset Link</button>

                    <div class="text-center mt-4">
                        <a asp-controller="Account" asp-action="Login" class="text-decoration-none">Back to Login</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>